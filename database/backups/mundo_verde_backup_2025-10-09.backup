-- TOC entry 244 (class 1259 OID 16926)
-- Name: vista_eliminaciones_pendientes; Type: VIEW; Schema: public; Owner: postgres
--

CREATE VIEW public.vista_eliminaciones_pendientes AS
 SELECT id,
    email_solicitante,
    nombre_solicitante,
    tipo_eliminacion,
    estado,
    fecha_solicitud,
    fecha_limite_legal,
    EXTRACT(day FROM ((fecha_limite_legal)::timestamp with time zone - CURRENT_TIMESTAMP)) AS dias_restantes,
    prioridad
   FROM public.solicitudes_eliminacion
  WHERE ((estado)::text = ANY ((ARRAY['PENDIENTE'::character varying, 'EN_REVISION'::character varying, 'APROBADA'::character varying, 'PROCESANDO'::character varying])::text[]))
  ORDER BY fecha_limite_legal;


