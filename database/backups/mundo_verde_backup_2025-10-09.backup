    usuario_id uuid,
    email_solicitante character varying(255) NOT NULL,
    nombre_solicitante character varying(255),
    empresa_solicitante character varying(500),
    tipo_eliminacion character varying(100) NOT NULL,
    alcance text,
    motivo text,
    categoria_motivo character varying(100),
    estado character varying(50) DEFAULT 'PENDIENTE'::character varying NOT NULL,
    prioridad character varying(20) DEFAULT 'NORMAL'::character varying,
    fecha_solicitud timestamp without time zone DEFAULT CURRENT_TIMESTAMP,
    fecha_limite_legal timestamp without time zone,
    fecha_inicio_procesamiento timestamp without time zone,
    fecha_completada timestamp without time zone,
    procesado_por character varying(255),
    procesado_por_email character varying(255),
    notas_admin text,
    acciones_realizadas jsonb,
    datos_eliminados jsonb,
    certificado_eliminacion text,
    hash_verificacion character varying(255),
    telefono_contacto character varying(50),
    metodo_notificacion_preferido character varying(50),
    created_at timestamp without time zone DEFAULT CURRENT_TIMESTAMP,
    updated_at timestamp without time zone DEFAULT CURRENT_TIMESTAMP,
    CONSTRAINT estado_valido CHECK (((estado)::text = ANY ((ARRAY['PENDIENTE'::character varying, 'EN_REVISION'::character varying, 'APROBADA'::character varying, 'PROCESANDO'::character varying, 'COMPLETADA'::character varying, 'RECHAZADA'::character varying, 'CANCELADA'::character varying])::text[]))),
    CONSTRAINT prioridad_valida CHECK (((prioridad)::text = ANY ((ARRAY['BAJA'::character varying, 'NORMAL'::character varying, 'ALTA'::character varying, 'URGENTE'::character varying])::text[]))),
    CONSTRAINT tipo_eliminacion_valido CHECK (((tipo_eliminacion)::text = ANY ((ARRAY['CUENTA_COMPLETA'::character varying, 'CALCULOS_ESPECIFICOS'::character varying, 'DATOS_EMPRESA'::character varying, 'CONSENTIMIENTOS'::character varying, 'HISTORIAL_COMPLETO'::character varying, 'DATOS_PERSONALES'::character varying])::text[])))
);


