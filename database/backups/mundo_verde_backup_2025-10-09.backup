CREATE VIEW public.vista_accesos_recientes AS
 SELECT email_usuario,
    accion,
    tipo_dato,
    fecha_acceso,
    ip_address,
    resultado
   FROM public.log_acceso_datos
  WHERE (fecha_acceso >= (CURRENT_TIMESTAMP - '30 days'::interval))
  ORDER BY fecha_acceso DESC;


