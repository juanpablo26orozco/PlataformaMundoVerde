--
-- TOC entry 246 (class 1259 OID 16960)
-- Name: v_resumen_emisiones; Type: VIEW; Schema: public; Owner: postgres
--

CREATE VIEW public.v_resumen_emisiones AS
 SELECT id,
    codigo_seguimiento,
    nombre_empresa,
    nit,
    "año_reporte",
    fecha_reporte,
    emisiones_alcance_1,
    emisiones_alcance_2,
    emisiones_alcance_3,
    emisiones_totales,
    nivel_evaluacion,
    arboles_compensar,
    ( SELECT count(*) AS count
           FROM public.combustibles_solidos
          WHERE (combustibles_solidos.calculo_id = h.id)) AS num_solidos,
    ( SELECT count(*) AS count
           FROM public.combustibles_liquidos
          WHERE (combustibles_liquidos.calculo_id = h.id)) AS num_liquidos,
    ( SELECT count(*) AS count
           FROM public.combustibles_gaseosos
          WHERE (combustibles_gaseosos.calculo_id = h.id)) AS num_gaseosos,
    ( SELECT count(*) AS count
           FROM public.consumo_electricidad
          WHERE (consumo_electricidad.calculo_id = h.id)) AS num_instalaciones_elect,
    ( SELECT count(*) AS count
           FROM public.vuelos_aereos
          WHERE (vuelos_aereos.calculo_id = h.id)) AS num_vuelos,
    ( SELECT count(*) AS count
           FROM public.extintores
          WHERE (extintores.calculo_id = h.id)) AS num_extintores
   FROM public.calculos_huella_carbono h
  ORDER BY fecha_reporte DESC;


ALTER VIEW public.v_resumen_emisiones OWNER TO postgres;

--
-- TOC entry 5522 (class 0 OID 0)
