    CONSTRAINT accion_valida CHECK (((accion)::text = ANY ((ARRAY['VIEW'::character varying, 'VIEW_ALL'::character varying, 'EXPORT'::character varying, 'EXPORT_PDF'::character varying, 'EXPORT_JSON'::character varying, 'DELETE'::character varying, 'DELETE_ALL'::character varying, 'MODIFY'::character varying, 'CREATE'::character varying, 'DOWNLOAD'::character varying, 'SHARE'::character varying, 'PRINT'::character varying])::text[]))),
    CONSTRAINT tipo_dato_valido CHECK (((tipo_dato)::text = ANY ((ARRAY['DATOS_EMPRESA'::character varying, 'CALCULO_HUELLA'::character varying, 'CALCULO_AUTOGESTION'::character varying, 'COMBUSTIBLES'::character varying, 'ELECTRICIDAD'::character varying, 'VUELOS'::character varying, 'EXTINTORES'::character varying, 'RESPUESTAS_AUTOGESTION'::character varying, 'DOCUMENTOS_PDF'::character varying, 'REPORTES'::character varying, 'DATOS_PERSONALES'::character varying, 'CONSENTIMIENTOS'::character varying, 'PERFIL_USUARIO'::character varying])::text[])))
);


