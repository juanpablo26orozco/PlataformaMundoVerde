--
-- TOC entry 248 (class 1259 OID 16970)
-- Name: v_historico_autogestion; Type: VIEW; Schema: public; Owner: postgres
--

CREATE VIEW public.v_historico_autogestion AS
 SELECT id,
    codigo_seguimiento,
    nombre_empresa,
    nit,
    "año_reporte",
    fecha_reporte,
    porcentaje_economico,
    porcentaje_ambiental,
    porcentaje_energia,
    porcentaje_seguridad,
    porcentaje_social,
    porcentaje_almacen,
    porcentaje_final,
    nivel_cumplimiento,
    ( SELECT count(*) AS count
           FROM public.respuestas_autogestion
          WHERE (respuestas_autogestion.calculo_id = a.id)) AS total_respuestas
   FROM public.calculos_autogestion a
  ORDER BY nit, "año_reporte" DESC;


ALTER VIEW public.v_historico_autogestion OWNER TO postgres;

--
-- TOC entry 5519 (class 0 OID 0)
-- Dependencies: 248
-- Name: VIEW v_historico_autogestion; Type: COMMENT; Schema: public; Owner: postgres
--

COMMENT ON VIEW public.v_historico_autogestion IS 'Histórico de autogestión con métricas consolidadas';


--
-- TOC entry 247 (class 1259 OID 16965)
-- Name: v_ranking_empresas; Type: VIEW; Schema: public; Owner: postgres
--

CREATE VIEW public.v_ranking_empresas AS
 SELECT nit,
    nombre_empresa,
    count(*) AS total_calculos,
    avg(emisiones_totales) AS promedio_emisiones,
    max(emisiones_totales) AS max_emisiones,
    min(emisiones_totales) AS min_emisiones,
    max("año_reporte") AS "ultimo_año"
   FROM public.calculos_huella_carbono
  GROUP BY nit, nombre_empresa
  ORDER BY (avg(emisiones_totales)) DESC;


ALTER VIEW public.v_ranking_empresas OWNER TO postgres;

--
-- TOC entry 5520 (class 0 OID 0)
-- Dependencies: 247
-- Name: VIEW v_ranking_empresas; Type: COMMENT; Schema: public; Owner: postgres
--

COMMENT ON VIEW public.v_ranking_empresas IS 'Ranking de empresas por emisiones promedio';


