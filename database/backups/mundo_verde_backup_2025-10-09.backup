    CONSTRAINT porcentajes_validos CHECK ((((porcentaje_economico >= (0)::numeric) AND (porcentaje_economico <= (100)::numeric)) AND ((porcentaje_ambiental >= (0)::numeric) AND (porcentaje_ambiental <= (100)::numeric)) AND ((porcentaje_energia >= (0)::numeric) AND (porcentaje_energia <= (100)::numeric)) AND ((porcentaje_seguridad >= (0)::numeric) AND (porcentaje_seguridad <= (100)::numeric)) AND ((porcentaje_social >= (0)::numeric) AND (porcentaje_social <= (100)::numeric)) AND ((porcentaje_almacen >= (0)::numeric) AND (porcentaje_almacen <= (100)::numeric))))
);


