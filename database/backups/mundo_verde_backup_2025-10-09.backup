--
-- TOC entry 323 (class 1255 OID 16976)
-- Name: obtener_factor_electricidad(character varying, integer); Type: FUNCTION; Schema: public; Owner: postgres
--

CREATE FUNCTION public.obtener_factor_electricidad(p_pais character varying DEFAULT 'Colombia'::character varying, "p_año" integer DEFAULT NULL::integer) RETURNS numeric
    LANGUAGE plpgsql
    AS $$
DECLARE
    v_factor DECIMAL(10,6);
    v_año_usar INTEGER;
BEGIN
    -- Si no se especifica año, usar el actual
    IF p_año IS NULL THEN
        v_año_usar := EXTRACT(YEAR FROM CURRENT_DATE);
    ELSE
        v_año_usar := p_año;
    END IF;
    
    -- Buscar factor para el país y año especificado
    SELECT factor_emision INTO v_factor
    FROM factores_electricidad_pais
    WHERE pais = p_pais 
    AND año = v_año_usar
    AND activo = true;
    
    -- Si no se encuentra, buscar el año más reciente disponible
    IF v_factor IS NULL THEN
        SELECT factor_emision INTO v_factor
        FROM factores_electricidad_pais
        WHERE pais = p_pais
        AND activo = true
        ORDER BY año DESC
        LIMIT 1;
    END IF;
    
    -- Si aún no hay factor, usar Colombia por defecto
    IF v_factor IS NULL THEN
        v_factor := 0.391;  -- Colombia 2024
    END IF;
    
    RETURN v_factor;
END;
$$;


