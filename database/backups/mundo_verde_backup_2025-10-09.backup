    porcentaje_seguridad numeric(5,2) DEFAULT 0,
    porcentaje_social numeric(5,2) DEFAULT 0,
    porcentaje_almacen numeric(5,2) DEFAULT 0,
    porcentaje_final numeric(5,2) GENERATED ALWAYS AS (((((((porcentaje_economico + porcentaje_ambiental) + porcentaje_energia) + porcentaje_seguridad) + porcentaje_social) + porcentaje_almacen) / 6.0)) STORED,
    nivel_cumplimiento character varying(50),
