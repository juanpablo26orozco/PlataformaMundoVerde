-- TOC entry 250 (class 1259 OID 17000)
-- Name: vista_autogestion_optimizada; Type: VIEW; Schema: public; Owner: postgres
--

CREATE VIEW public.vista_autogestion_optimizada AS
 SELECT id,
    codigo_seguimiento,
    nombre_empresa,
    nit,
    sector,
    "año_reporte",
    fecha_reporte,
    porcentaje_economico,
    porcentaje_ambiental,
    porcentaje_energia,
    porcentaje_seguridad,
    porcentaje_social,
    porcentaje_almacen,
    porcentaje_final,
    nivel_cumplimiento,
    pdf_nombre,
    pdf_size,
        CASE
            WHEN (pdf_reporte IS NOT NULL) THEN true
            ELSE false
        END AS tiene_pdf,
    fecha_creacion,
    estado
   FROM public.calculos_autogestion
  ORDER BY fecha_creacion DESC;


