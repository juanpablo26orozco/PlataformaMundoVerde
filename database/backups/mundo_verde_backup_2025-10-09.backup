-- Name: vuelos_aereos; Type: TABLE; Schema: public; Owner: postgres
--

CREATE TABLE public.vuelos_aereos (
    id uuid DEFAULT gen_random_uuid() NOT NULL,
    calculo_id uuid NOT NULL,
    ciudad_origen character varying(255) NOT NULL,
    ciudad_destino character varying(255) NOT NULL,
    pais_origen character varying(100),
    pais_destino character varying(100),
    tipo_vuelo character varying(50),
    clase character varying(50),
    numero_pasajeros integer DEFAULT 1,
    distancia_km numeric(15,2),
    factor_emision numeric(10,6),
    emision_kg numeric(15,4),
    emision_ton numeric(15,4),
    fecha_registro timestamp without time zone DEFAULT CURRENT_TIMESTAMP,
    CONSTRAINT distancia_positiva CHECK ((distancia_km > (0)::numeric)),
    CONSTRAINT pasajeros_positivo CHECK ((numero_pasajeros > 0))
);


ALTER TABLE public.vuelos_aereos OWNER TO postgres;

