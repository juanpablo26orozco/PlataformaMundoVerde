    calculo_id uuid NOT NULL,
    seccion character(1) NOT NULL,
    bloque character varying(10) NOT NULL,
    nombre_bloque character varying(255),
    promedio_bloque numeric(5,3),
    total_preguntas integer,
    preguntas_respondidas integer,
    fecha_calculo timestamp without time zone DEFAULT CURRENT_TIMESTAMP,
    CONSTRAINT promedio_valido CHECK (((promedio_bloque >= (0)::numeric) AND (promedio_bloque <= (3)::numeric))),
    CONSTRAINT seccion_valida CHECK ((seccion = ANY (ARRAY['A'::bpchar, 'B'::bpchar, 'C'::bpchar, 'D'::bpchar, 'E'::bpchar, 'F'::bpchar])))
);


