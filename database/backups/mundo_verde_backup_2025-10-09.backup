--

CREATE FUNCTION public.extraer_pdf_autogestion(p_codigo_seguimiento character varying) RETURNS TABLE(codigo character varying, nombre_archivo character varying, "tamaño_bytes" bigint, pdf_base64 text)
    LANGUAGE plpgsql
    AS $$
BEGIN
    RETURN QUERY
    SELECT 
        a.codigo_seguimiento,
        a.pdf_nombre,
        a.pdf_size,
        encode(a.pdf_reporte, 'base64') as pdf_base64
    FROM calculos_autogestion a
    WHERE a.codigo_seguimiento = p_codigo_seguimiento
    AND a.pdf_reporte IS NOT NULL;
END;
$$;


