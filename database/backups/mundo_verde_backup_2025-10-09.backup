--
-- TOC entry 300 (class 1255 OID 16920)
-- Name: registrar_revocacion_consentimiento(); Type: FUNCTION; Schema: public; Owner: postgres
--

CREATE FUNCTION public.registrar_revocacion_consentimiento() RETURNS trigger
    LANGUAGE plpgsql
    AS $$
BEGIN
    IF NEW.consentimiento_revocado = true AND OLD.consentimiento_revocado = false THEN
        INSERT INTO log_acceso_datos (
            usuario_id,
            email_usuario,
            accion,
            tipo_dato,
            descripcion,
            resultado
        ) VALUES (
            NEW.usuario_id,
            NEW.email_usuario,
            'MODIFY',
            'CONSENTIMIENTOS',
            'Revocación de consentimiento - Motivo: ' || COALESCE(NEW.motivo_revocacion, 'No especificado'),
            'SUCCESS'
        );
    END IF;
    RETURN NEW;
END;
$$;


